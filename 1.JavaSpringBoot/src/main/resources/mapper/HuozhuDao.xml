<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.HuozhuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.HuozhuEntity" id="huozhuMap">
        <result property="huozhuzhanghao" column="huozhuzhanghao"/>
        <result property="mima" column="mima"/>
        <result property="huozhuxingming" column="huozhuxingming"/>
        <result property="huozhushouji" column="huozhushouji"/>
        <result property="touxiang" column="touxiang"/>
        <result property="sfsh" column="sfsh"/>
        <result property="shhf" column="shhf"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.HuozhuView" >

		SELECT  huozhu.* FROM huozhu  huozhu 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.HuozhuView" >
		SELECT * FROM huozhu  huozhu <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
